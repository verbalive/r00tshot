#include <windows.h>

1 24 "r00tshot.manifest"

1 VERSIONINFO
FILEVERSION    1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK  0x3fL
FILEFLAGS      0x0L
FILEOS         0x40004L
FILETYPE       0x1L
FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "r00tshot"
            VALUE "FileDescription",  "r00tshot screen capture"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "r00tshot"
            VALUE "LegalCopyright",   "r00tshot"
            VALUE "OriginalFilename", "r00tshot.exe"
            VALUE "ProductName",      "r00tshot"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
